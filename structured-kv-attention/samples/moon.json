      "n_tokens_est": 3,
      "pos_start_est": 293
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "markup",
      "text": "<p>",
      "n_tokens_est": 3,
      "pos_start_est": 296
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": "[N]ew findings suggest that the Moon was primarily created from material ejected from Earth’s ",
