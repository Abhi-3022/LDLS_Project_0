      "pos_start_est": 225
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": " among scientists to explain how the Moon formed.",
      "n_tokens_est": 9,
      "pos_start_est": 228
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": " According to this ",
