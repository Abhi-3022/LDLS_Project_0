      "pos_start_est": 372
    },
    {
      "node_id": 3,
      "seq_id": 2,
      "kind": "content",
      "text": " on Earth. So if a person weighs 60",
      "n_tokens_est": 9,
      "pos_start_est": 373
    },
    {
      "node_id": 3,
      "seq_id": 2,
      "kind": "content",
      "text": "kilograms on Earth, the person would only weigh 10",
      "n_tokens_est": 10,
      "pos_start_est": 382
    },
    {
      "node_id": 3,
      "seq_id": 2,
      "kind": "content",
      "text": "kilograms on the Moon.",
