      "text": "<p>",
      "n_tokens_est": 3,
      "pos_start_est": 274
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": " Recent research has challenged this hypothesis. According to one article:",
      "n_tokens_est": 12,
      "pos_start_est": 277
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "markup",
      "text": "</p>",
      "n_tokens_est": 4,
      "pos_start_est": 289
