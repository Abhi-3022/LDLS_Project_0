      "seq_id": 0,
      "kind": "markup",
      "text": "<p>",
      "n_tokens_est": 3,
      "pos_start_est": 177
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": "Some other planets also have moons or natural satellites. The ",
