      "pos_start_est": 162
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": " per year due to the effect of ",
      "n_tokens_est": 7,
      "pos_start_est": 163
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": "tidal dissipation",
      "n_tokens_est": 2,
      "pos_start_est": 170
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": ".",
