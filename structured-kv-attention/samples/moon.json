      "pos_start_est": 94
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": "The ",
      "n_tokens_est": 1,
      "pos_start_est": 97
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": "gravity",
      "n_tokens_est": 1,
      "pos_start_est": 98
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": " on the Moon is one-sixth of the Earth's gravity.",
      "n_tokens_est": 14,
      "pos_start_est": 99
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": " It means that an object will be one-sixth as heavy on the Moon compared to Earth. ",
      "n_tokens_est": 19,
      "pos_start_est": 113
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "markup",
      "text": "</p>",
      "n_tokens_est": 4,
      "pos_start_est": 132
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "markup",
      "text": "<p>",
      "n_tokens_est": 3,
      "pos_start_est": 136
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": "The Moon is a ",
      "n_tokens_est": 4,
      "pos_start_est": 139
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": "rocky",
