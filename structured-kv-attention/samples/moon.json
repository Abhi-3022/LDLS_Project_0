      "n_tokens_est": 3,
      "pos_start_est": 355
    },
    {
      "node_id": 3,
      "seq_id": 2,
      "kind": "content",
      "text": "Because it is smaller, the Moon has only 1/6 of the ",
      "n_tokens_est": 14,
      "pos_start_est": 358
    },
    {
      "node_id": 3,
      "seq_id": 2,
      "kind": "content",
      "text": "gravity",
