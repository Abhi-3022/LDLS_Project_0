      "seq_id": 2,
      "kind": "markup",
      "text": "<p>",
      "n_tokens_est": 3,
      "pos_start_est": 482
    },
    {
      "node_id": 3,
      "seq_id": 2,
      "kind": "content",
      "text": "Because the Moon has no ",
      "n_tokens_est": 5,
      "pos_start_est": 485
    },
    {
      "node_id": 3,
      "seq_id": 2,
      "kind": "content",
      "text": "atmosphere",
      "n_tokens_est": 1,
      "pos_start_est": 490
    },
    {
      "node_id": 3,
      "seq_id": 2,
      "kind": "content",
      "text": ", there is no ",
      "n_tokens_est": 4,
      "pos_start_est": 491
    },
    {
      "node_id": 3,
      "seq_id": 2,
      "kind": "content",
      "text": "air resistance",
