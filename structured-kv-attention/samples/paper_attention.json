    },
    {
      "node_id": 5,
      "seq_id": 4,
      "kind": "content",
      "text": "The decoder is also composed of a stack of ",
      "n_tokens_est": 9,
      "pos_start_est": 1325
    },
    {
      "node_id": 5,
      "seq_id": 4,
      "kind": "content",
