      "n_tokens_est": 2,
      "pos_start_est": 381
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": "vaswani2017attention",
      "n_tokens_est": 1,
      "pos_start_est": 383
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": " have emerged as the most widely used architecture in applications such as natural language processing and image classification. Transformers have grown larger",
      "n_tokens_est": 23,
      "pos_start_est": 384
    },
    {
      "node_id": 2,
