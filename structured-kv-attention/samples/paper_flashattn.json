      "pos_start_est": 677
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": " left). On modern GPUs, compute speed has out-paced memory speed",
      "n_tokens_est": 15,
      "pos_start_est": 680
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "markup",
