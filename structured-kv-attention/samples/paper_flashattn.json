      "pos_start_est": 344
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": " accuracy) and Path-256 (seq.",
      "n_tokens_est": 9,
      "pos_start_est": 346
    },
    {
      "node_id": 1,
