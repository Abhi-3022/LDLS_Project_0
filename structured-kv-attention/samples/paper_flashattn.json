      "n_tokens_est": 1,
      "pos_start_est": 410
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": " and deeper",
      "n_tokens_est": 2,
      "pos_start_est": 411
    },
    {
