      "seq_id": 1,
      "kind": "markup",
      "text": "\\citep",
      "n_tokens_est": 2,
      "pos_start_est": 755
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": "ramakrishnan2003database",
      "n_tokens_est": 1,
      "pos_start_est": 757
    },
    {
      "node_id": 2,
