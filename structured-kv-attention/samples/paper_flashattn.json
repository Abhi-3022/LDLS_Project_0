      "pos_start_est": 1210
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": "can serve as a useful primitive for realizing the potential of approximate attention algorithms by overcoming their issues with memory access overhead. As a proof of concept, we implement block-sparse ",
      "n_tokens_est": 34,
      "pos_start_est": 1212
    },
