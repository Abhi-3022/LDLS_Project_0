      "pos_start_est": 1098
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": " is the head dimension and ",
      "n_tokens_est": 5,
      "pos_start_est": 1101
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": "$M$",
