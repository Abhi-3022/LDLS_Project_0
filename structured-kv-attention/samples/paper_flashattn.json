      "n_tokens_est": 1,
      "pos_start_est": 671
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": ", Figure",
      "n_tokens_est": 2,
      "pos_start_est": 672
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "markup",
      "text": "~",
