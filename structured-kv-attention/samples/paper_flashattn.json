      "seq_id": 1,
      "kind": "markup",
      "text": "\\citep",
      "n_tokens_est": 2,
      "pos_start_est": 696
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": "nvidia2017nvidia,nvidia2020nvidia,nvidia2022nvidia",
      "n_tokens_est": 5,
      "pos_start_est": 698
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": ", and most operations in Transformers are bottlenecked by memory accesses",
      "n_tokens_est": 11,
      "pos_start_est": 703
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "markup",
      "text": "~",
      "n_tokens_est": 1,
      "pos_start_est": 714
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "markup",
      "text": "\\citep",
      "n_tokens_est": 2,
      "pos_start_est": 715
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": "ivanov2021data",
      "n_tokens_est": 1,
      "pos_start_est": 717
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": ". IO-aware algorithms have been critical for similar memory-bound operations, when reading and writing data can account for a large portion of the runtime",
      "n_tokens_est": 29,
      "pos_start_est": 718
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "markup",
