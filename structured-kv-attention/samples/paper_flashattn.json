      "pos_start_est": 1106
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": " is the size of SRAM, as compared to ",
      "n_tokens_est": 9,
      "pos_start_est": 1109
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": "$\\Omega(Nd + N^2)$",
      "n_tokens_est": 11,
      "pos_start_est": 1118
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": " of standard attention. For typical values of ",
      "n_tokens_est": 8,
      "pos_start_est": 1129
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": "$d$",
