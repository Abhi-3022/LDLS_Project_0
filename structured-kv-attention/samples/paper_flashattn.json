      "pos_start_est": 277
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": "enable longer context in Transformers, yielding higher quality models (0.7 better perplexity on GPT-2 and 6.4 points of lift on long-document classification) and entirely new capabilities: the first Transformers to achieve better-than-chance performance on the Path-X challenge (seq.",
      "n_tokens_est": 58,
      "pos_start_est": 279
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "markup",
      "text": "\\ ",
      "n_tokens_est": 1,
      "pos_start_est": 337
    },
    {
      "node_id": 1,
      "seq_id": 0,
      "kind": "content",
      "text": "length 16K, 61.4",
      "n_tokens_est": 6,
      "pos_start_est": 338
    },
    {
