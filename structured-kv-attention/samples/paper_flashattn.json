      "seq_id": 1,
      "kind": "markup",
      "text": "\\citep",
      "n_tokens_est": 2,
      "pos_start_est": 762
    },
    {
      "node_id": 2,
      "seq_id": 1,
      "kind": "content",
      "text": "ragan2013halide",
